# Copy to .env (or export) before running.
# SEC requires "Company Name contact@email"; requests without it get HTTP 403.
SEC_USER_AGENT="MobiusFinance Hackathon your-email@example.com"

# 1 = never call upstreams, serve only cache + committed demo snapshot.
DATA_OFFLINE=0

# Optional sources, comma separated: peers,news,macro
DATA_OPTIONAL=

# DATA_CACHE_DIR=./cache
# DATA_DEMO_CACHE_DIR=./demo_cache
